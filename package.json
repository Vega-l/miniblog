{
  "name": "miniblog",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Miniblog —— Vue 3 + Pinia 前端 + Hono RESTful 后端（内存存储）的小型发布页",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "start:api": "tsx server/index.ts",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "vitest run tests/server",
    "test:web": "vitest run tests/core tests/stores tests/components",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18",
    "pinia": "^4.1.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
